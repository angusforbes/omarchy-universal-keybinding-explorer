#!/bin/bash
# keybinding-explorer [on|off|esc|toggle]: the Universal Keybinding Explorer's switch (Omarchy).
#
# on:  switch Hyprland to the `keybinding-explorer` submap (only Escape and the
#      opening chord are bound there) and summon the overlay, which then receives
#      every other key and explains it. The focused window's class and title go
#      along, so the overlay starts in that app's context when a keymap's
#      "focus" rule matches it.
# esc: Escape in the submap. In app mode (the overlay touches
#      $XDG_RUNTIME_DIR/keybinding-explorer-app) it goes back to the Hyprland
#      keys; otherwise it leaves like `off`. The flag is removed first, so a
#      second Esc always leaves even if the overlay died.
# off: hide the overlay and return to the normal keymap.
# Bindings: hypr/bindings.lua in the repo.

set -u
PLUGIN="angusforbes.universal-keybinding-explorer"
FLAG="${XDG_RUNTIME_DIR:-/tmp}/keybinding-explorer-app"

on() {
  rm -f "$FLAG"
  local payload
  payload=$(hyprctl activewindow -j 2>/dev/null | jq -c '{focus: {class: (.class // ""), title: (.title // "")}}' 2>/dev/null)
  [[ -n $payload ]] || payload='{}'
  if [[ $(omarchy-shell shell summon "$PLUGIN" "$payload" 2>/dev/null) != *ok* ]]; then
    notify-send -u low "Universal Keybinding Explorer" "Could not open the overlay (is omarchy-shell running and the plugin enabled?)"
    exit 1
  fi
  hyprctl dispatch 'hl.dsp.submap("keybinding-explorer")' >/dev/null
}

off() {
  rm -f "$FLAG"
  omarchy-shell shell hide "$PLUGIN" >/dev/null 2>&1
  hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1
}

esc() {
  if [[ -e $FLAG ]]; then
    rm -f "$FLAG"
    omarchy-shell shell summon "$PLUGIN" '{"leaveApp":true}' >/dev/null 2>&1 || off
  else
    off
  fi
}

case "${1:-toggle}" in
  on) on ;;
  off) off ;;
  esc) esc ;;
  toggle) if [[ $(hyprctl submap 2>/dev/null) == keybinding-explorer ]]; then off; else on; fi ;;
  *) echo "usage: keybinding-explorer [on|off|esc|toggle]" >&2; exit 2 ;;
esac
